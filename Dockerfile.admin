# 1. Base Setup
FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# 2. Prune stage
FROM base AS pruner
WORKDIR /app
RUN npm install -g turbo
COPY . .
RUN turbo prune admin --docker

# 3. Installer stage
FROM base AS installer
WORKDIR /app
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

# 4. Build stage
COPY --from=pruner /app/out/full/ .
RUN npx turbo build --filter=admin

# Ensure directories exist
RUN mkdir -p apps/admin/.next/standalone apps/admin/.next/static apps/admin/public

# 5. Runner stage
FROM base AS runner
WORKDIR /app
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nodeuser
USER nodeuser

# Copy built outputs (Next.js standalone)
COPY --from=installer /app/apps/admin/.next/standalone ./
COPY --from=installer /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=installer /app/apps/admin/public ./apps/admin/public

EXPOSE 3001
ENV PORT=3001
CMD ["node", "apps/admin/server.js"]
